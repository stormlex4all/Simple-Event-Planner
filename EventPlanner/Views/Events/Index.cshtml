@model List<EventPlanner.Models.Event>

@{
    ViewData["Title"] = "Upcoming Events";
}

<h1>My Event Planner</h1>

<p>Welcome to your event planner!</p>

<a asp-controller="Events"
   asp-action="Create"
   class="btn btn-primary">
    Create New Event
</a>

@if (Model.Count == 0)
{
    <p>No events yet. Create your first event!</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Location</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Date.ToString("MMM dd, yyyy h:mm tt")</td>
                    <td>@item.Location</td>
                    <td>//RSVP</td>
                    <td>conflicting change</td>
                    <td></td>
                </tr>
            }
        </tbody>
    </table>
}
