@model List<EventPlanner.Models.Event>

@{
    ViewData["Title"] = "Upcoming Events";
}

<h1>Upcoming Events</h1>
@if (TempData["Message"] is string message)
{
    <div class="ok">@message</div>
}
@if (Model.Count == 0)
{
    <p>No upcoming events yet. <a asp-action="Create">Create one</a>.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Event Name</th>
                <th>Date</th>
                <th>Location</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Date.ToString("MMM dd, yyyy h:mm tt")</td>
                    <td>@item.Location</td>
                    <td><a asp-controller="Rsvp" asp-action="Create" asp-route-eventId="@item.Id">RSVP</a></td>
                    <td></td>
                </tr>
            }
        </tbody>
    </table>
}
